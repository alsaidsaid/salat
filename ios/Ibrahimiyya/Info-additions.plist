<?xml version="1.0" encoding="UTF-8"?>
<!--
  المفاتيح المطلوب إضافتها إلى Info.plist في مشروع Xcode.
  Xcode ينشئ Info.plist تلقائياً؛ أضف هذه المفاتيح من تبويب Info في إعدادات الهدف
  أو الصقها داخل <dict> الرئيسي في ملف Info.plist إن كان لديك ملف صريح.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- اسم التطبيق كما يظهر تحت الأيقونة -->
    <key>CFBundleDisplayName</key>
    <string>الصلاة الإبراهيمية</string>

    <!-- لغة التطبيق الأساسية: العربية (مهمة لاتجاه الواجهة من اليمين لليسار) -->
    <key>CFBundleDevelopmentRegion</key>
    <string>ar</string>

    <!-- مُعرّف تطبيقك في AdMob — استبدله بمعرّفك الحقيقي -->
    <key>GADApplicationIdentifier</key>
    <string>ca-app-pub-XXXXXXXXXXXXXXXX~ZZZZZZZZZZ</string>

    <!-- نص إذن التتبّع (ATT) — يظهر للمستخدم في النافذة -->
    <key>NSUserTrackingUsageDescription</key>
    <string>يُستخدم هذا الإذن لعرض إعلانات أكثر ملاءمة لك. التطبيق لا يجمع أي بيانات عن أذكارك أو عدد صلواتك.</string>

    <!-- وضع رأسي فقط -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!--
      SKAdNetworkItems: قائمة معرّفات شبكات الإعلانات.
      انسخ القائمة الكاملة والمحدَّثة من وثائق AdMob:
      https://developers.google.com/admob/ios/quick-start#update_your_infoplist
      (تتجاوز 100 عنصر ولا يصح تخمينها — انسخها من المصدر الرسمي)
    -->
    <key>SKAdNetworkItems</key>
    <array>
        <dict>
            <key>SKAdNetworkIdentifier</key>
            <string>cstr6suwn9.skadnetwork</string>
        </dict>
        <!-- … أكمل بقية القائمة من وثائق AdMob … -->
    </array>
</dict>
</plist>
